{
  "name": "true-beauty",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "tsx watch apps/api/src/index.ts",
    "build": "tsc --noEmit && node scripts/build-notices.mjs && vite build && node scripts/build-offline.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "models": "node packages/vision-core/scripts/fetch-models.mjs",
    "test:production": "TB_E2E_PRODUCTION=1 playwright test tests/e2e/product.spec.ts",
    "format": "prettier --write apps/web/src apps/api/src packages/*/src scripts tests *.ts *.js *.json"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^9.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "@mediapipe/tasks-vision": "^0.10.32",
    "@react-three/fiber": "^9.4.0",
    "@techstark/opencv-js": "^5.0.0-release.1",
    "dexie": "^4.2.1",
    "dexie-react-hooks": "^4.2.0",
    "fastify": "^5.6.2",
    "lucide-react": "^0.552.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.181.1",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "fake-indexeddb": "^6.2.4",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^7.2.0",
    "vitest": "^4.0.8"
  }
}
