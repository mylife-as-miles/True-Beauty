# Server process only. Do not expose these as VITE variables or browser settings.
API_HOST=127.0.0.1
API_PORT=3001
API_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
YOUCAM_ENABLE_PAID=false
YOUCAM_MAX_DAILY_CREDITS=0
# Set YOUCAM_API_KEY through a server secret mechanism.
# A reviewed exact-action pricing plan is also required; see docs/API_CONTRACTS.md.
# YOUCAM_SKIN_PLAN_JSON=
# YOUCAM_USAGE_PATH=.runtime/usage.json

# Optional server-only generation plans and native reasoning. Never use VITE_*.
# YOUCAM_GENERATION_PLANS_JSON=[]
# ANTHROPIC_API_KEY is supplied by a server secret mechanism.
TB_REASONING_PROVIDER=anthropic
TB_REASONING_ENABLE_PAID=false
TB_REASONING_DAILY_USD=0
TB_REASONING_MAX_REQUEST_USD=0
# TB_REASONING_MODEL=<account-available exact model>
# TB_REASONING_PRICING_JSON=<operator-reviewed current official rates>
# TB_REASONING_USAGE_PATH=.runtime/reasoning-usage.json

# Hosted Worker: configure these names only through Sites server secret settings.
# SITE_ORIGIN=https://<existing-site-origin>
# EDGE_SESSION_SECRET=<cryptographically random server secret>
# EDGE_DATA_SECRET=<separate cryptographically random encryption secret>
# EDGE_OPERATOR_TOKEN=<server-tooling-only credential; never browser storage>
# EDGE_BUDGET_ID=<stable cumulative ledger identity; never rotate to reset usage>
# OPERATOR_SITE_USER_ID=<trusted Site-scoped operator ID>
# OPERATOR_SITE_USER_EMAIL=<optional exact owner allowlist>
# Keep false until hosted identity-header provenance is verified.
# SITES_IDENTITY_TRUSTED=false
